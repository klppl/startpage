# PHP Configuration
# Uncomment if you need to increase PHP limits
# php_value upload_max_filesize 10M
# php_value post_max_size 10M

# Ensure PHP files are processed
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# Deny access to JSON files for security (optional)
# You can uncomment this if you don't want JSON files accessible via URL
# <FilesMatch "\.json$">
#     Deny from all
# </FilesMatch>

